{
  "name": "cdk-composition",
  "version": "0.1.0",
  "description": "Higher-level composition patterns for AWS CDK TypeScript",
  "keywords": ["aws-cdk", "cdk", "typescript", "composition", "constructs", "patterns"],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "aws-cdk-lib": "^2.100.0",
    "bun-types": "^1.3.14",
    "constructs": "^10.3.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.8.0"
  }
}
