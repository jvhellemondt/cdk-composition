{
  "name": "@arts-n-crafts/cdk-composition",
  "version": "0.1.0",
  "description": "Higher-level composition patterns for AWS CDK TypeScript",
  "keywords": ["aws-cdk", "cdk", "typescript", "composition", "constructs", "patterns"],
  "license": "MIT",
  "homepage": "https://github.com/jvhellemondt/cdk-composition#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvhellemondt/cdk-composition.git"
  },
  "bugs": {
    "url": "https://github.com/jvhellemondt/cdk-composition/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:js && bun run build:types",
    "build:clean": "rm -rf dist",
    "build:js": "bun build src/index.ts --outfile dist/index.mjs --target node --format esm --external aws-cdk-lib --external constructs && bun build src/index.ts --outfile dist/index.cjs --target node --format cjs --external aws-cdk-lib --external constructs",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch --timeout 30000",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18"
  },
  "devDependencies": {
    "aws-cdk": "^2.262.0",
    "aws-cdk-lib": "^2.262.0",
    "aws-cdk-local": "^2.0.0",
    "bun-types": "^1.3.14",
    "constructs": "^10.3.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.2"
  }
}
