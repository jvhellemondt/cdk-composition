{
  "name": "@arts-n-crafts/cdk-composition",
  "version": "0.1.3",
  "description": "Higher-level composition patterns for AWS CDK TypeScript",
  "keywords": [
    "aws-cdk",
    "cdk",
    "typescript",
    "composition",
    "constructs",
    "patterns"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jvhellemondt/cdk-composition#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvhellemondt/cdk-composition.git"
  },
  "bugs": {
    "url": "https://github.com/jvhellemondt/cdk-composition/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test --timeout 30000",
    "test:watch": "bun test --watch --timeout 30000",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18"
  },
  "devDependencies": {
    "aws-cdk": "^2.262.0",
    "aws-cdk-lib": "^2.262.0",
    "aws-cdk-local": "^2.0.0",
    "bun-types": "^1.3.14",
    "constructs": "^10.3.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
